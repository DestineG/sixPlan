{
  "name": "sixplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @sixplan/shared",
    "dev": "concurrently -n server,web -c cyan,green \"npm run dev -w @sixplan/server\" \"npm run dev -w @sixplan/web\"",
    "build": "npm run build -w @sixplan/shared && npm run build -w @sixplan/web && npm run build -w @sixplan/server",
    "start": "npm run start -w @sixplan/server",
    "admin": "npm run admin -w @sixplan/server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages e2e eslint.config.js vite.config.ts playwright.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
