# 局域网 HTTP
SIXPLAN_HTTP_BIND=0.0.0.0
SIXPLAN_HTTP_PORT=4173
SIXPLAN_DATA_VOLUME=sixplan-data

# HTTPS 网关（使用 compose.https.yaml 时必填）
SIXPLAN_HTTPS_HOST=203.0.113.10
SIXPLAN_HTTPS_BIND=0.0.0.0
SIXPLAN_HTTPS_HTTP_PORT=80
SIXPLAN_HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# 计划 JSON 导入硬上限（可选，以下为默认值）
SIXPLAN_IMPORT_MAX_FILE_BYTES=536870912
SIXPLAN_IMPORT_MAX_NODES=50000
SIXPLAN_IMPORT_MAX_EDGES=250000
SIXPLAN_IMPORT_MAX_MARKDOWN_BYTES=5242880
SIXPLAN_IMPORT_MAX_TEMP_BYTES=2147483648
SIXPLAN_IMPORT_MAX_CONCURRENT_USER=2
SIXPLAN_IMPORT_MAX_CONCURRENT_GLOBAL=8
SIXPLAN_IMPORT_TASK_TIMEOUT_MS=1800000
SIXPLAN_IMPORT_SESSION_HOURS=24
